<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: system splash = dark background + the cube icon, then the app's own splash (LED ring) -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/win_bg</item>
        <item name="android:windowSplashScreenBackground">@color/win_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_fg</item>
    </style>
</resources>
